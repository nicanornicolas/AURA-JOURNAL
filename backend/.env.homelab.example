# Copy to .env.homelab and change the password. Never commit .env.homelab.
POSTGRES_USER=aura
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aura_journal

# hf = Hugging Face emotion models (English + Swahili via translation), ~2 GB RAM
# none = rules-only image, ~150 MB RAM (set EARS_PROVIDER=lexicon too)
EARS_EXTRAS=hf
EARS_PROVIDER=auto

# file = bundled seed places (dev); postgres = curated places synced from Airtable
PLACES_SOURCE=file

# Shared by the auth service (signs tokens) and the entries API (verifies them).
# Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-string
# true = every journal request needs a login token.
# false = the app can keep sending user_id in the body (LAN testing only).
# Switch to true once the app's login screens are in.
AUTH_REQUIRED=false
