# API Configuration
# Required on a physical phone. Points at the homelab server (static IP on the
# NIKOS-HOMELAB Tenda network; check on the server with: hostname -I).
# The phone must be on NIKOS-HOMELAB Wi-Fi: the server is behind the Tenda's NAT,
# so devices on the main router's Wi-Fi cannot reach it.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8001

# For production, use your server URL
# EXPO_PUBLIC_API_URL=https://your-api-server.com